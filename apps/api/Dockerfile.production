# syntax=docker/dockerfile:1
# Production image for the Ledgerly API: FrankenPHP (Caddy + PHP 8.4), OPcache, no dev packages, non-root.
# Built and pushed to GHCR by .github/workflows/deploy.yml. Local development uses ./Dockerfile instead.
#
# Runtime contract (all from the host's secret store, never baked into the image, SECURITY.md S9):
#   APP_KEY, APP_URL, FRONTEND_URL, DB_HOST, DB_DATABASE, DB_USERNAME=ledgerly_web, DB_PASSWORD, REDIS_HOST ...
# The owner credentials are NOT given to this container. Migrations run as a separate one-off task:
#   docker run --rm -e DB_OWNER_USERNAME=... -e DB_OWNER_PASSWORD=... <image> php artisan migrate --database=owner --force

FROM composer:2 AS vendor
WORKDIR /app
COPY composer.json composer.lock ./
# Extensions live in the runtime image, so platform checks are done there (composer check-platform-reqs).
RUN composer install --no-dev --no-scripts --no-autoloader --prefer-dist --no-interaction --no-progress --ignore-platform-reqs
COPY . .
RUN composer dump-autoload --no-dev --optimize --classmap-authoritative --no-scripts

FROM dunglas/frankenphp:1-php8.4 AS runtime
RUN install-php-extensions pdo_pgsql intl bcmath zip pcntl redis opcache \
    && cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"
COPY docker/php-production.ini "$PHP_INI_DIR/conf.d/zz-ledgerly.ini"

ENV APP_ENV=production \
    APP_DEBUG=false \
    LOG_CHANNEL=stderr \
    SERVER_NAME=:8080

WORKDIR /app
COPY --from=vendor /app /app
RUN php artisan package:discover --ansi \
    && mkdir -p storage/framework/cache storage/framework/sessions storage/framework/views storage/logs bootstrap/cache \
    && useradd --system --no-create-home --uid 10001 ledgerly \
    && chown -R ledgerly:ledgerly storage bootstrap/cache /data/caddy /config/caddy

USER ledgerly
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=3s --retries=5 CMD ["php", "-r", "exit(@file_get_contents('http://127.0.0.1:8080/up') === false ? 1 : 0);"]
