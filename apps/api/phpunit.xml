<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <server name="APP_ENV" value="testing" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <server name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <server name="CACHE_STORE" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <server name="QUEUE_CONNECTION" value="sync" force="true"/>
        <!-- SECURITY.md S1: the schema is built as the owner, every request runs as ledgerly_web so
             row-level security applies, exactly as in production (tests/RefreshLedgerDatabase.php).
             force="true" plus a matching <server> entry: Laravel reads $_SERVER first, where docker-compose puts its
             environment, so <env> alone let tests run against the development database. -->
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <server name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_DATABASE" value="ledgerly_test" force="true"/>
        <server name="DB_DATABASE" value="ledgerly_test" force="true"/>
        <env name="DB_USERNAME" value="ledgerly_web" force="true"/>
        <server name="DB_USERNAME" value="ledgerly_web" force="true"/>
        <env name="DB_PASSWORD" value="ledgerly_web" force="true"/>
        <server name="DB_PASSWORD" value="ledgerly_web" force="true"/>
        <env name="DB_OWNER_USERNAME" value="ledgerly_owner" force="true"/>
        <server name="DB_OWNER_USERNAME" value="ledgerly_owner" force="true"/>
        <env name="DB_OWNER_PASSWORD" value="ledgerly_owner" force="true"/>
        <server name="DB_OWNER_PASSWORD" value="ledgerly_owner" force="true"/>
        <env name="EINVOICE_FORCE_SANDBOX" value="true" force="true"/>
        <server name="EINVOICE_FORCE_SANDBOX" value="true" force="true"/>
    </php>
</phpunit>
