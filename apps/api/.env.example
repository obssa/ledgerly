APP_NAME=Ledgerly
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en

# PostgreSQL 16+. Migrations run as the OWNER role; the app runs as a member of ledgerly_app so
# row-level security applies (see database/schema/005_rls.sql and docker/postgres/init.sql).
# The API connects as ledgerly_web (row-level security applies). In production point DB_HOST at PgBouncer
# in transaction mode: the tenant context is transaction-local, so pooled connections are safe.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ledgerly
DB_USERNAME=ledgerly_web
DB_PASSWORD=ledgerly_web
DB_OWNER_URL=postgresql://ledgerly_owner:ledgerly_owner@127.0.0.1:5432/ledgerly

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
CACHE_STORE=redis
QUEUE_CONNECTION=redis

FILESYSTEM_DISK=s3
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_BUCKET=ledgerly
AWS_USE_PATH_STYLE_ENDPOINT=true

SANCTUM_STATEFUL_DOMAINS=localhost:3000

# E-invoicing: sandbox until each authority's spec, credentials and accreditation are in place.
EINVOICE_FORCE_SANDBOX=true
EINVOICE_ET_BASE_URL=
EINVOICE_KE_BASE_URL=
EINVOICE_KE_SALES_ENDPOINT=
