APP_NAME=Ledgerly
# PRODUCTION: APP_ENV=production, APP_DEBUG=false (debug pages show secrets), APP_URL=https://...
# Secrets (APP_KEY, database and API passwords) come from the host's secret store, never from a file in git.
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en

# PostgreSQL 16+. Migrations run as the OWNER role; the app runs as a member of ledgerly_app so
# row-level security applies (see database/schema/005_rls.sql and docker/postgres/init.sql).
# The API connects as ledgerly_web (row-level security applies). In production point DB_HOST at PgBouncer
# in transaction mode: the tenant context is transaction-local, so pooled connections are safe.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ledgerly
DB_USERNAME=ledgerly_web
DB_PASSWORD=ledgerly_web
DB_OWNER_URL=postgresql://ledgerly_owner:ledgerly_owner@127.0.0.1:5432/ledgerly
# Owner login for `php artisan migrate --database=owner`. LOCAL DEVELOPMENT ONLY: in production these exist only in the
# one-off migration task, never in the API's environment (SECURITY.md §4).
DB_OWNER_USERNAME=ledgerly_owner
DB_OWNER_PASSWORD=ledgerly_owner

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
CACHE_STORE=redis
QUEUE_CONNECTION=redis

FILESYSTEM_DISK=s3
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_BUCKET=ledgerly
AWS_USE_PATH_STYLE_ENDPOINT=true

SANCTUM_STATEFUL_DOMAINS=localhost:3000
SANCTUM_TOKEN_MINUTES=720
# The only web address allowed to call the API from a browser (config/cors.php when added): no wildcard.
FRONTEND_URL=http://localhost:3000
# Load balancer addresses (comma separated) whose X-Forwarded-* headers are trusted. Empty locally.
TRUSTED_PROXIES=
# Shared with the web app (its LEDGERLY_WEB_KEY): lets the web server say which visitor it acts for, so
# sign-in limits count people, not the web server. Any long random value; empty turns it off.
WEB_SERVER_KEY=
# With CACHE_STORE=database, give the cache its own session: DB_CACHE_CONNECTION=cache

# E-invoicing: sandbox until each authority's spec, credentials and accreditation are in place.
EINVOICE_FORCE_SANDBOX=true
EINVOICE_ET_BASE_URL=
EINVOICE_KE_BASE_URL=
EINVOICE_KE_SALES_ENDPOINT=
